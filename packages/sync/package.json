{
  "name": "@market-track/sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --dir src",
    "sync:up": "docker compose -f config/docker-compose.yaml up -d",
    "sync:down": "docker compose -f config/docker-compose.yaml down -v",
    "test:sync": "vitest run --dir test"
  },
  "devDependencies": {
    "@powersync/node": "^0.19.4",
    "better-sqlite3": "^12.11.0",
    "@supabase/supabase-js": "^2.110.6",
    "pg": "^8.13.0",
    "@types/pg": "^8.11.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
