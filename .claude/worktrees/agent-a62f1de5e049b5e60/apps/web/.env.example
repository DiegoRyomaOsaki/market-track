# Variables PÚBLICAS de la web. Se empaquetan en el bundle del navegador: aquí NO
# va ningún secreto (la service_role key salta RLS — nunca bajo NEXT_PUBLIC_).
# La anon key es pública por diseño; RLS la contiene.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapa base (ADR-0009). Desarrollo: pnpm tiles:dev y esta ruta.
# Produccion: la URL del archivo de Peru en R2.
NEXT_PUBLIC_TILES_URL=/tiles/lima.pmtiles
