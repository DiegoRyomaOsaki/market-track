# Plantilla de variables de entorno. Copia a `.env` y rellena.
#
# `.env` y `.env.*` están en .gitignore. Si alguna vez commiteas un secreto,
# rotarlo es obligatorio: borrarlo del repo NO lo borra del historial.
#
# Cuando existan `apps/web` y `apps/mobile`, cada una tendrá su propio
# `.env.example` con el subconjunto que le toca. Este es el catálogo completo.

# ---------------------------------------------------------------------------
# PÚBLICO — viaja al cliente. Next.js y Expo lo INCRUSTAN en el bundle en tiempo
# de build: una vez publicado, está en el teléfono de cualquiera con el APK.
#
# La anon key es pública POR DISEÑO: quien la contiene es RLS, no el secreto.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

SENTRY_DSN=

# ---------------------------------------------------------------------------
# SOLO SERVIDOR — jamás con prefijo NEXT_PUBLIC_ ni EXPO_PUBLIC_.
#
# ⛔ SUPABASE_SERVICE_ROLE_KEY **salta RLS por diseño**. Expuesta en un bundle,
#    cualquiera lee los datos de TODOS los clientes — justo lo que el contrato
#    promete que no puede pasar. Hay un test que falla si aparece bajo un prefijo
#    público; no lo desactives.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

RESEND_API_KEY=

# Secreto del hook `send_sms` de GoTrue (firma Standard Webhooks) que entrega el
# OTP del segundo factor. Lo lee el CLI de Supabase para sustituirlo en
# `config.toml`. Formato: v1,whsec_<base64>. Ver ADR-0008.
#
# ⚠️ EL MISMO VALOR tiene que estar también en `supabase/functions/.env`: de este
# fichero lo lee GoTrue (para FIRMAR) y de aquel la Edge Function (para
# VERIFICAR). Si difieren, nadie completa el segundo factor. Generarlo con:
#   python -c "import os,base64;print('v1,whsec_'+base64.b64encode(os.urandom(24)).decode())"
SEND_SMS_HOOK_SECRET=
