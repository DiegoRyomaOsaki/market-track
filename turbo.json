{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "//#lint": {
      "inputs": [
        "eslint.config.mjs",
        "tsconfig.json",
        "tsconfig.base.json",
        "package.json"
      ]
    },
    "//#typecheck": {
      "inputs": [
        "eslint.config.mjs",
        "tsconfig.json",
        "tsconfig.base.json",
        "package.json"
      ]
    }
  }
}
