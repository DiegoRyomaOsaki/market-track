{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  // Solo los archivos de la RAÍZ: cada workspace trae su propio tsconfig.
  // Los globs cubren cualquier archivo suelto que alguien deje aquí — si solo
  // se listara `eslint.config.mjs`, un `.ts` en la raíz pasaría el typecheck en
  // silencio (tsc no lo miraría) y a la vez rompería el lint con un error
  // críptico del project service. Las dos herramientas deben ver lo mismo.
  "include": ["*.mjs", "*.mts", "*.ts", "*.cts", "*.js", "scripts/**/*.ts"]
}
