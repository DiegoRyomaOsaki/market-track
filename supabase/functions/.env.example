# Secretos que consumen las Edge Functions (Deno). Copia este archivo a
#   supabase/functions/.env      (lo ignora .gitignore: nunca se commitea)
# y rellena los valores. Yo referencio los NOMBRES en el código
# (`Deno.env.get("RESEND_API_KEY")`) — el valor nunca pasa por el chat ni al repo.
#
#   Local:  supabase functions serve --env-file supabase/functions/.env
#   Nube:   supabase secrets set --env-file supabase/functions/.env
#
# OJO: SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los INYECTA Supabase solo en las
# Edge Functions — NO hace falta ponerlos aquí.

# ── Resend — envío de emails (alertas de precio/quiebre y OTP por correo).
#    Tickets: MAR-62 (email de alertas), MAR-23 (entrega del OTP por correo).
RESEND_API_KEY=
# Remitente verificado en Resend (NO es secreto; puedes ponerlo tal cual).
RESEND_FROM=alertas@tu-dominio.com

# ── PowerSync — clave PRIVADA para firmar los JWT que autentican al cliente de
#    sync contra tu instancia. Ticket: MAR-26. (La URL de la instancia, que NO es
#    secreta, va en el .env raíz como POWERSYNC_URL.)
POWERSYNC_PRIVATE_KEY=

# ── Cloudflare R2 — URLs firmadas de fotos. Ticket: MAR-27. (Aún sin cuenta.)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Pase de acceso temporal — clave para el HMAC del código de 6 dígitos. Sin
#    ella la función `emitir-pase` NO arranca (fail-closed). Ticket: MAR-24.
PASE_HASH_SECRET=

# ── Verificación de fotos contra R2 — secreto compartido con el que pg_cron
#    (`app.barrer_fotos_sin_verificar`, GUC app.settings.foto_verificacion_secret)
#    invoca `fotos-verificar`. Sin él la función NO arranca (fail-closed).
FOTO_VERIFICACION_SECRET=

# ── Hook `send_sms` — firma del hook que entrega el OTP del 2FA (ADR-0008).
#    Formato: v1,whsec_<base64>. Ticket: MAR-23.
#
#    ⚠️ NO HACE FALTA definirlo aquí: `config.toml` ya se lo pasa al runtime desde
#    el `.env` de la RAÍZ. Si se define, ESTE valor SOMBREA al de la raíz — y uno
#    malformado deja la función sin arrancar y `test:sync` en rojo ENTERO, con
#    `supabase start` saliendo con éxito. Si lo pones, que sea idéntico al de la
#    raíz: uno válido pero distinto hace que la firma no cuadre. Ver SETUP.md.
SEND_SMS_HOOK_SECRET=

# Solo DESARROLLO: con `true`, `enviar-otp` no manda correo y deja el código en el
# log de la función. Es un permiso EXPLÍCITO: sin él y sin RESEND_API_KEY la
# función falla cerrada, para que una producción mal aprovisionada no finja que
# entregó (ni escupa el OTP en los logs).
OTP_DRY_RUN=false
